# Merge this block into ~/.ssh/config on the administrator workstation.
# The jump-host password is entered interactively and is never stored here.
# === Carrel: B09 site ===
Host b09-jump
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
  HostName 140.113.60.189
  User p4user
  Port 22
  ConnectTimeout 15
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host carrel01 192.168.13.159
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  HostName 192.168.13.159
  User root
  Port 22
  ProxyJump b09-jump
  ConnectTimeout 20
  StrictHostKeyChecking accept-new
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m
Host carrel-stg01
  HostName 172.31.255.2
  User root
  ProxyJump carrel01
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ControlMaster auto
  ControlPath ~/.ssh/control-%C
  ControlPersist 10m

# === end Carrel: B09 site ===
