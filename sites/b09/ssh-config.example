# Merge this block into ~/.ssh/config on the administrator workstation.
# The management network 192.168.19.0/24 is reached through the site's WireGuard
# link to 140.113.60.189; root logins use the administrator key.
# === Carrel: B09 site ===
Host carrel01 carrel02 carrel03 carrel04
  User root
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
Host carrel01
  HostName 192.168.19.101
Host carrel02
  HostName 192.168.19.102
Host carrel03
  HostName 192.168.19.103
Host carrel04
  HostName 192.168.19.104
# === end Carrel: B09 site ===
